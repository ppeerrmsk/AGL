[resource]
script = ExtResource("1")
display_name = "Cre"
; ── Cre 系对抗学习原型机（宿敌 ORION，spec events/ace-orion §2.1）──
; "看上去普通"：机体基线 = 初始敌机级别（杂鱼下位档），伪装用普通敌方橙。
; 强度成长不改本资源——OrionNemesisEvent 按生涯击坠数查档位表，spawn 时
; 覆写 AI 四维 / 武器挂载 / 闪避 / 性能乘数（×1.0→×1.4）。
; 武器/热诱弹在此为满配占位，低档位由事件层清零（档 I 仅机炮、无 flare）。
; 王牌专属机型：不进随机刷怪池；无人原型机（no_pilot，全程无线电静默）
