[gd_resource type="Resource" script_class="FlareParams" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/flare_params.gd" id="1"]

; 王牌中队专属热诱弹 —— 有限 break 尝试（spec flare-evasion-coupling / ace-squadron-tier）
;   max_flares = 4 / burst_count = 1 → 整场最多 4 次尝试，不再等同 4 条保证命数
;   fail_chance=0 保证会投放；实际成功率读 AI 有效操控等级，且必须在 1.25s 内真实改变航迹
;   enable_flare_reload 恒 false → 耗尽永不补充，之后只剩纯运动学规避
;   nervousness = 0.5 → 投放距离 lerp(200, 600, 0.5) = 400 m
[resource]
script = ExtResource("1")
max_flares = 4
burst_count = 1
cooldown = 1.2
base_jam_chance = 1.0
aspect_bonus = 0.0
maneuvering_bonus = 0.0
close_range_penalty = 0.0
low_energy_bonus = 0.0
nervousness = 0.5
panic_distance = 600.0
calm_distance = 200.0
