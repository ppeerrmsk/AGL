[gd_resource type="Resource" script_class="RocketParams" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/rocket_params.gd" id="1"]

[resource]
script = ExtResource("1")
display_name = "Hydra 70 (Wing Pods)"
; ── 涟发：左右挂点逐发交替，每发 0.04s；近段直飞后渐进展开为 14° 扇面 ──
burst_count_min = 8
burst_count_max = 8
burst_interval = 0.04
burst_cooldown = 4.0
; ── 弹道（高速 + 长寿命） ──
; rocket_damage 直击伤害，以导弹（80）为参考，贴脸 100 + 末端衰减到 70
; min_damage_mult 0.7：飞到 max_range 时倍率 = 0.7（直击 70 / AOE 63）
; 平均交战距离仍高于导弹 80，符合"绝大多数情况比导弹高"
rocket_damage = 100.0
muzzle_velocity = 600.0
max_range = 3800.0
min_damage_mult = 0.7
; spread_angle 表示远段最终扇面半角（每发按 [-spread, +spread] 等距分布）
spread_angle = 14.0
; fire_cone_half_angle 现在表示自动扫描锥（前方多大锥内有敌机就触发齐射）
fire_cone_half_angle = 35.0
min_range = 200.0
max_fire_range = 2200.0
; ── 弹药：无限 ──
max_ammo = 999
infinite_ammo = true
; ── 近炸引信 + AOE（容错率高的近身武器） ──
; aoe_damage 90：以导弹 80 为基准略高；同样按 min_damage_mult 衰减（末端 = 63）
proximity_fuse_radius_m = 80.0
aoe_radius_m = 120.0
aoe_damage = 90.0
