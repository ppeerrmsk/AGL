[gd_resource type="Resource" script_class="MissileParams" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/missile_params.gd" id="1"]

; Mother Goose 母舰 VLS 弹（数值 = cg_vls_missile 的克隆，只改 display_name）
; 为什么单独一份：母舰原先直接借用巡洋舰的 cg_vls_missile.tres，导弹 HUD 标签就写着 "CG-VLS"
; ——CG 是巡洋舰舷号前缀，玩家在 BOSS 战里看到一串 "CG-VLS" 跟着无人机飞过陆地，
; 会读成"有船跟着无人机移动、还开到岸上去了"。母舰的武器必须报母舰的名字。

[resource]
script = ExtResource("1")
display_name = "GOOSE-VLS"
max_speed = 800.0
motor_burn_time = 3.5
motor_acceleration = 200.0
drag_deceleration = 25.0
max_g = 20.0
nav_constant = 1.8
max_range_rear = 9000.0
front_rear_ratio = 1.2
min_range = 1500.0
max_lifetime = 28.0
damage = 22.0
proximity_fuse_radius = 20.0
proximity_fuse_alt = 300.0
seeker_fov = 60.0
guidance_delay = 0.3
fire_and_forget = true
max_count = 80
cooldown = 6.0
is_vls_salvo = true
vls_salvo_size = 4
vls_salvo_interval = 0.07
vls_salvo_cooldown = 35.0
vls_point_scatter_px = 200.0
vls_climb_time = 0.9
vls_transition_time = 0.7
vls_transition_turn_rate_degs = 130.0
vls_speed_variance = 0.22
intercept_hp = 45.0
