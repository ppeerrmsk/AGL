# Godot 4+ specific ignores
.godot/
/android/

# 编辑器模式下 F9 导出的战斗日志（见 scripts/event_logger.gd:dump_to_file）
/logs/

# Godot 导出产物（AGL.exe / AGL.console.exe / .pck 等）
/AGL*.exe
/AGL*.pck

# 项目根的临时 script-check / 解析探针文件（如 _parse_check.gd 及其 Godot 自动伴生的 .uid）
# 这类文件来自 `godot --script-check` 等临时验证流程，跑完应被删除；防止 .uid orphan 留下
/_*.gd
/_*.gd.uid

# bench harness 输出（每次跑分自动生成，不入库）
/bench/results/

# 本地机器配置 / 临时状态（含绝对路径或 per-machine 数据，不应入库）
# .mcp.json 含本机 Godot 绝对路径；settings.local.json / worktrees / 锁文件均为 per-machine
/.mcp.json
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/worktrees/

