# Godot 4+ specific ignores
.godot/
/android/

# 编辑器模式下 F9 导出的战斗日志（见 scripts/event_logger.gd:dump_to_file）
/logs/
/bench/results/

# Godot 导出产物（AGL.exe / AGL.console.exe / .pck 等）
/AGL*.exe
/AGL*.pck

# 项目根的临时 script-check / 解析探针文件（如 _parse_check.gd 及其 Godot 自动伴生的 .uid）
# 这类文件来自 `godot --script-check` 等临时验证流程，跑完应被删除；防止 .uid orphan 留下
/_*.gd
/_*.gd.uid

# Python 工具脚本的字节码缓存（tools/*.py）
__pycache__/

# Claude Code 本地产物（机器专属 / 临时，不入库）
.claude/worktrees/
.claude/scheduled_tasks.lock
.mcp.json

# Agent/工具临时产物：保留目录内的 .gdignore，让 Godot 不扫描正在写入的图片/脚本。
/tmp/*
!/tmp/.gdignore
